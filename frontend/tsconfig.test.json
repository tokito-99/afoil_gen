{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist-test",
    "rootDir": "src"
  },
  "include": [
    "src/index.ts",
    "src/config/**/*.ts",
    "src/types/**/*.ts",
    "src/utils/**/*.ts",
    "src/validation/**/*.ts"
  ]
}
